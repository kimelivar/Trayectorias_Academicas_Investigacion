# =====================================
# ENTORNOS
# =====================================
venv/
.env


# =====================================
# DEPENDENCIAS
# =====================================
node_modules/


# =====================================
# DATOS SENSIBLES
# =====================================

# Ignorar todos los datos originales
data/*

# Mantener estructura de carpetas
!data/raw/
!data/raw/pdf_estudiantes/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Proteger información académica
data/raw/pdf_estudiantes/*.pdf
data/**/*.csv


# =====================================
# RESULTADOS EXPERIMENTALES
# =====================================

# Permitir resultados para revisión académica
!results/

# Ignorar archivos temporales
results/**/*.tmp


# =====================================
# MODELOS
# =====================================

# Modelos entrenados (si contienen datos)
*.h5
*.pt
*.pkl
*.joblib


# =====================================
# PYTHON
# =====================================
__pycache__/
*.pyc
.ipynb_checkpoints/


# =====================================
# COMPILADOS
# =====================================
*.hex
*.class


# =====================================
# SISTEMA
# =====================================
.DS_Store
Thumbs.db

# Asignaciones individuales de estudiantes
results/**/asignaciones_*.csv